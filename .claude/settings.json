{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(gofmt *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(golangci-lint *)"
    ],
    "deny": []
  }
}
